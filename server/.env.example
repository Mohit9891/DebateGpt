# Copy to .env and fill in
PORT=5000
CLIENT_URL=http://localhost:5173
GROQ_API_KEY=gsk_your_key_here
# Groq retired llama-3.3-70b-versatile on 2026-08-16. Defaults below are live replacements.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Google OAuth (https://console.cloud.google.com → APIs & Services → Credentials → Web client)
# Add Authorized JS origin: http://localhost:5173 (and your Vercel URL)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
JWT_SECRET=change-me-to-a-long-random-string
# Get from MongoDB Atlas → Connect → Drivers → Node.js
MONGO_URI=mongodb+srv://<user>:<pass>@cluster0.xxx.mongodb.net/debategpt?retryWrites=true&w=majority
